<?xml version="1.0" encoding="UTF-8"?>
<!--
  raspybank-lancamento  —  Módulo M3
  ==========
  O contexto financeiro do mínimo aceitável: categoria, subcategoria, conta,
  o vínculo conta×ambiente e o lançamento.

  POR QUE OS CINCO VIVEM NO MESMO MÓDULO, E NÃO EM TRÊS
  Porque são o mesmo assunto. O lançamento não existe sem categoria e sem
  conta — as chaves compostas da V10 amarram os três no banco, e separá-los
  em módulos obrigaria a referenciá-los por identificador solto, perdendo a
  relação JPA sem ganhar fronteira nenhuma. Fronteira serve para separar o
  que muda por motivos diferentes; estes três mudam juntos.

  Cartão (V11) será módulo próprio: ele referencia conta por identificador,
  tem ciclo de vida próprio (fatura, parcela) e é exatamente o caso em que a
  fronteira paga o próprio custo.

  Como os outros contextos, depende SÓ do shared. Referencia usuário e
  ambiente por identificador, nunca por objeto.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.raspybank</groupId>
        <artifactId>raspybank</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>raspybank-lancamento</artifactId>
    <name>RaspyBank :: Lancamento</name>

    <dependencies>
        <dependency>
            <groupId>com.raspybank</groupId>
            <artifactId>raspybank-shared</artifactId>
        </dependency>
    </dependencies>
</project>
